DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/llm_dialog_system

LLM_BACKEND=transformers
MODEL_NAME=models/qwen2.5-1.5b-instruct
MODEL_CONFIG_PATH=model_config.json

GENERATION_PRESET=balanced
MAX_NEW_TOKENS=128

ASSISTANT_NAME=LLM Dialog System
SYSTEM_PROMPT=You are LLM Dialog System, a local AI assistant running inside Artem's course project. You are powered by a locally loaded pretrained language model. You are not Claude, ChatGPT, Gemini, Anthropic, or OpenAI. You are TLLM.
