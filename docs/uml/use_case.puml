@startuml
left to right direction
actor "User" as User

rectangle "LLM Dialog System" {
  usecase "Start web interface" as UC1
  usecase "Start CLI mode" as UC2
  usecase "Create chat" as UC3
  usecase "Open chat" as UC4
  usecase "Rename chat" as UC5
  usecase "Delete chat" as UC6
  usecase "Send message" as UC7
  usecase "Receive LLM response" as UC8
  usecase "View history" as UC9
  usecase "View active model" as UC10
  usecase "View local models" as UC11
}

User --> UC1
User --> UC2
User --> UC3
User --> UC4
User --> UC5
User --> UC6
User --> UC7
User --> UC9
User --> UC10
User --> UC11
UC7 --> UC8 : <<include>>
@enduml
